---
import SectionIndex from './SectionIndex.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const facts = [
  { title: 'Read-only', body: 'Never writes inside ~/.claude.' },
  {
    title: 'Your token stays put',
    body: 'Your OAuth token is only sent to Anthropic’s usage endpoint. --no-usage-api turns that off.',
  },
  {
    title: 'Two hosts',
    body: 'Only two hosts are contacted: api.anthropic.com and raw.githubusercontent.com.',
  },
];
---

<section id="safety" class="page-wrap safety" aria-labelledby="safety-title">
  <SectionIndex fig="04" name="Safety" />
  <h2 id="safety-title">It reads your Claude Code data and changes none of it</h2>

  <dl class="items">
    {facts.map((it) => (
      <div>
        <dt>{it.title}</dt>
        <dd>{it.body}</dd>
      </div>
    ))}
  </dl>

  <p class="more"><a href={`${base}/docs/#privacy`}>Read the full privacy and safety details</a></p>
</section>

<style>
  .safety { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  h2 {
    font-size: clamp(1.625rem, 3.2vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    max-width: 20ch;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0;
  }
  .items { margin: 0; border-top: 1px solid var(--border); max-width: 44rem; }
  .items > div { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  dt { font-weight: 600; margin-bottom: 0.3rem; }
  dd { margin: 0; max-width: 62ch; line-height: 1.55; color: var(--muted-foreground); overflow-wrap: anywhere; }
  .more { margin: 1.25rem 0 0; }
  .more a { color: var(--foreground); text-decoration: underline; text-underline-offset: 3px; }
  .more a:focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
</style>
