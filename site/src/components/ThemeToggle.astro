---
// Ported from the Kojima template's theme toggle (vanilla, no React).
---

<button
  type="button"
  id="theme-toggle"
  aria-pressed="false"
  aria-label="Light theme"
  title="Toggle light theme"
  class="text-foreground border-border hover:bg-accent focus-visible:outline-ring flex size-11 items-center justify-center border transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
>
  <svg class="theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  /* Dark is the default: show the sun (action = go light). */
  .theme-icon-moon { display: none; }
  :global(html:not(.dark)) .theme-icon-sun { display: none; }
  :global(html:not(.dark)) .theme-icon-moon { display: block; }
</style>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () => {
    const light = !root.classList.contains('dark');
    // aria-pressed = "light theme is on"; the label stays constant.
    button?.setAttribute('aria-pressed', String(light));
  };
  sync();
  button?.addEventListener('click', () => {
    const nextDark = !root.classList.contains('dark');
    root.classList.toggle('dark', nextDark);
    root.style.colorScheme = nextDark ? 'dark' : 'light';
    sync();
    try {
      localStorage.setItem('theme', nextDark ? 'dark' : 'light');
    } catch {
      /* Theme remains usable when storage is blocked. */
    }
  });
</script>
