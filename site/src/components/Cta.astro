---
import CopyCommand from './CopyCommand.astro';
---

<section class="cta page-wrap" aria-labelledby="cta-title">
  <div class="cta__inner">
    <h2 id="cta-title" class="cta__title">Open a terminal and run it.</h2>
    <p class="cta__text">No account and no setup. It finds your running Claude Code sessions on its own.</p>
    <div class="cta__actions">
      <CopyCommand cmd="npx ccstatusboard" label="Copy install command" class="cta__cmd" />
      <a class="cta__link" href="#install">Other ways to install</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(56px, 9vw, 120px); }
  .cta__inner { max-width: 44rem; }
  .cta__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .cta__text {
    margin: 16px 0 0;
    max-width: 60ch;
    color: var(--muted-foreground);
    line-height: 1.55;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 28px;
  }
  .cta__actions :global(.cta__cmd) { flex: 0 1 auto; min-width: 0; max-width: 100%; }
  .cta__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--input);
  }
  .cta__link:hover { text-decoration-color: var(--primary); }
  .cta__link:focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
</style>
