---
// Contact form posting to Web3Forms. Without a build-time key it falls back to
// an email link. The email link also shows until the script takes over, so a
// visitor whose JS is off or failed to load never sees a dead form or an empty card.
import { EMAIL } from '../content/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
if (!accessKey) {
  console.warn(
    '[ContactForm] PUBLIC_WEB3FORMS_ACCESS_KEY is not set. Rendering an email link instead of the contact form. ' +
      'Copy site/.env.example to site/.env and add a Web3Forms access key.',
  );
}
---

{
  accessKey ? (
    <div class="plate plate-pad contact-form" data-email={EMAIL}>
      <form hidden data-contact-form>
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="ccstatusboard site: new contact" />
        <input type="hidden" name="from_name" value="ccstatusboard site" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="contact-form__field">
          <label for="contact-name">Name</label>
          <input id="contact-name" type="text" name="name" autocomplete="name" required />
        </div>
        <div class="contact-form__field">
          <label for="contact-email">Email</label>
          <input id="contact-email" type="email" name="email" autocomplete="email" required />
        </div>
        <div class="contact-form__field">
          <label for="contact-topic">What's this about?</label>
          <select id="contact-topic" name="topic" required>
            <option value="" disabled selected>
              Choose one
            </option>
            <option value="Freelance project">Freelance project</option>
            <option value="Job offer">Job offer</option>
            <option value="Something else">Something else</option>
          </select>
        </div>
        <div class="contact-form__field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="6" required />
        </div>

        <div class="contact-form__error" role="alert" data-contact-error />
        <button type="submit" class="contact-form__button" data-contact-submit>
          Send message
        </button>
      </form>
      <p data-contact-fallback>
        Email Alec at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
      </p>
      <div class="contact-form__sent" aria-live="polite" tabindex="-1" data-contact-sent hidden />
    </div>
  ) : (
    <div class="plate plate-pad contact-form">
      <p>
        Email Alec at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
      </p>
    </div>
  )
}

<style>
  .contact-form {
    min-width: 0;
    max-width: 100%;
  }
  .contact-form p {
    margin: 0;
  }
  /* :global because the error message's link is created by the script. */
  .contact-form :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-form :global(a:hover) {
    color: var(--kojima-accent-ink);
  }
  .contact-form :global(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  form {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  form[hidden] {
    display: none;
  }
  .contact-form__field {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  label {
    font-weight: 500;
  }
  input:not([type='hidden']):not([type='checkbox']),
  select,
  textarea {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--input);
    border-radius: 0;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.4;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  .contact-form__button:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .contact-form__button {
    min-height: 48px;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 0;
    background: var(--primary);
    color: var(--primary-foreground);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }
  .contact-form__button:disabled {
    cursor: default;
    opacity: 0.7;
  }
  .contact-form__error {
    overflow-wrap: anywhere;
  }
  .contact-form__error:empty {
    display: none;
  }
  .contact-form__error :global(p) {
    margin: 0 0 0.5rem;
  }
  .contact-form__sent {
    overflow-wrap: anywhere;
  }
  .contact-form__sent:focus {
    outline: none;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.contact-form[data-email]');
  const form = root?.querySelector<HTMLFormElement>('[data-contact-form]') ?? null;
  const button = form?.querySelector<HTMLButtonElement>('[data-contact-submit]') ?? null;
  const errorBox = form?.querySelector<HTMLElement>('[data-contact-error]') ?? null;
  const sent = root?.querySelector<HTMLElement>('[data-contact-sent]') ?? null;
  const email = root?.dataset.email ?? '';

  if (root && form && button) {
    const showError = (apiMessage: string | null) => {
      if (!errorBox) return;
      errorBox.textContent = '';
      const p = document.createElement('p');
      p.append("Your message wasn't sent. Try again, or email ");
      const a = document.createElement('a');
      a.href = `mailto:${email}`;
      a.textContent = email;
      p.append(a, '.');
      errorBox.append(p);
      if (apiMessage) {
        const detail = document.createElement('p');
        detail.textContent = apiMessage;
        errorBox.append(detail);
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = 'Sending...';
      if (errorBox) errorBox.textContent = '';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (response.status === 200) {
          form.hidden = true;
          if (sent) {
            sent.textContent = 'Message sent. Alec will reply to the email you gave.';
            sent.hidden = false;
            sent.focus();
          }
          return;
        }
        let apiMessage: string | null = null;
        try {
          const data: unknown = await response.json();
          const msg = (data as { message?: unknown } | null)?.message;
          if (typeof msg === 'string' && msg) apiMessage = msg;
        } catch {
          // Non-JSON body: fall through with the generic message.
        }
        showError(apiMessage);
      } catch {
        showError(null);
      }
      button.disabled = false;
      button.textContent = 'Send message';
      // Disabling the button dropped keyboard focus; put it back for the retry.
      button.focus();
    });

    // Reveal the form only once submit is handled, so it can never post natively.
    form.hidden = false;
    const fallback = root.querySelector<HTMLElement>('[data-contact-fallback]');
    if (fallback) fallback.hidden = true;
  }
</script>
