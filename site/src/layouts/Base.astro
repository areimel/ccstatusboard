---
import '../styles/global.css';
import dmSansRegular from '../assets/fonts/DMSans-Regular.ttf?url';
import monoRegular from '../assets/fonts/jetbrains-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = 'og-image.png' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/${image}`, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="kojima" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          /* Default to dark if storage is unavailable. */
        }
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.style.colorScheme = 'light';
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={dmSansRegular} as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href={monoRegular} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ccstatusboard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
